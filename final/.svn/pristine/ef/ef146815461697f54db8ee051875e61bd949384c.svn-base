<script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<script>

myWorkList()
function myWorkList(currentPage,keyword){
	let data = {
		     currentPage: currentPage,
	         keyword: keyword
	 	}
	let url = "/work/proj"
	axios.post(url,data)
	.then(function(res){
		console.log("체ㅡㅋ응",res)
		let content = res.data.content;
		
		let mytbody = document.querySelector("#mytbody");
		let str = ""
		for(let i =0; i<content.length; i++){
			let list = content[i]
			let stateClass = 'state0';
			let taskStatus = "";
			 if (list.taskStatus === '0') {
                 iconClass = 'state0';
                 taskStatus = "완료"
                 
             } else if (list.taskStatus === '1') {
                 iconClass = 'state1';
                 taskStatus = "진행중"
             } else if (list.taskStatus === '2') {
                 iconClass = 'state2';
                 taskStatus = "긴급"
             }
			
			
			console.log("체킁 리스트" , list)
				str +=`	
				<tr >
                    <th scope="row">1</th>
                    <td class="telft" ><div class="\${iconClass}">\${taskStatus}</div></td>
                    <td><a href="" class="a"><a href="" class="a">\${list.taskType}</a></a></td>
                    <td>하잭완</td>
                    <td>2025-01-03 </td>
                    <td>2025-01-03 </td>
                    <td>50%</td>
                </tr>
		`
				
				
				
			
		}
		
		mytbody.innerHTML = str
		
		console.log("에스티알체킁" ,str1)
	}).catch(function(error){
		
	})
	
	
	
	
	
	
}

</script>
