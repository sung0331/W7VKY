                                <thead>
                                    <tr>
                                        <th scope="col"><input type="checkbox"></th>
                                        <th scope="col" class="telft">파일명</th>
                                        <th scope="col">소유자</th>
                                        <th scope="col">날짜</th>
                                        <th scope="col">크기</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
