                                </tbody>
                            </table>
                <div class="row justify-content-center" id="divPagingArea"></div>
                        <%--     <center class="flex">
								<div class="row flexchid" id="divPagingArea">
									${articlePage.pagingArea}</div>
							</center> --%>
                        </div>
                        
                        <!--  -->
                        <div class="bg-light rounded h-100 p-4 file  " id="my">
	<div class="fileHeader">
	<div>

		<select name="languages" id="lang">
		<i class="fas fa-file"></i> 
		  <option value="javascript">모든파일 </option>
		  <option value="php">문서</option>
		  <option value="java">사진/동영상</option>
	 </select> 
			<button type="button" id="edit" class="btn btn-primary fileDwBt">다운로드</button> 
	</div>
			<div class="searchBar">
			 <input type="text" name="entName" class="updtcon searchInput" placeholder="검색어를 입력해 주세요.">
				<!-- <div class="searchText" contenteditable="true" >
					  <span class="placeholder">검색어를 입력해 주세요.</span>
				</div> -->
					  <i class="fa-solid fa-magnifying-glass"></i>
			</div>
	</div>
                            <table class="table table-borderless">
                                <thead>
                                    <tr>
                                        <th scope="col"><input type="checkbox"></th>
                                        <th scope="col" class="telft">파일명</th>
                                        <th scope="col">소유자</th>
                                        <th scope="col">날짜</th>
                                        <th scope="col">크기</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th scope="row"><input type="checkbox"></th>
                                        <td class="telft" ><i class="fa-solid fa-file-pdf"></i>파워포인트.pdf</td>
                                        <td>송중오</td>
                                        <td>2025-01-03 09:22 </td>
