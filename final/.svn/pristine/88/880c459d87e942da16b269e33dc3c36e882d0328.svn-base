		<li class="company nav" data-nav="my"><i class="fa-solid fa-user icon iconh"></i>개인파일</li>
		<li class="company nav" data-nav="department"><i class="fa-solid fa-users icon"></i>부서파일</li>
	</ul>
</div>
<div class="bg-light rounded h-100 p-4 file active" id="common">
